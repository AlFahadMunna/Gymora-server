PORT=5000
NODE_ENV=development

# MongoDB (shared database with the frontend's Better Auth user collection)
MONGODB_URI=your_mongodb_connection_string
DB_NAME=vertex-fitness

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000

# Secret used to sign this backend's own application JWT (separate from Better Auth)
JWT_SECRET=your_long_random_jwt_secret

# Base URL of the Better Auth server (the frontend Next.js app) — used to
# fetch its JWKS for verifying Better Auth session tokens in POST /jwt
BETTER_AUTH_URL=http://localhost:3000

# Stripe secret key (test mode) — never exposed to the client
STRIPE_SECRET_KEY=your_stripe_secret_key
