PORT=5000
NODE_ENV=development

# MongoDB (shared database with the frontend's Better Auth user collection)
MONGODB_URI=your_mongodb_connection_string
DB_NAME=vertex-fitness

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000

# Secret used to sign this backend's own application JWT (separate from Better Auth)
JWT_SECRET=your_long_random_jwt_secret

# --- Added in later stages ---
# BETTER_AUTH_JWKS_URL=            (Stage 2)
# STRIPE_SECRET_KEY=               (Stage 5)
